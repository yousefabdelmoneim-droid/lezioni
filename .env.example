# Copy to .env for local development (never commit .env).
# Local default is SQLite (app.db). For Neon use the connection string from the Neon console.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=change-me
ADMIN_USERNAME=papa
ADMIN_PASSWORD=change-me-too
# Set to 0 to skip automatic migrations on boot (then run: flask --app app migrate-db)
AUTO_MIGRATE=1
